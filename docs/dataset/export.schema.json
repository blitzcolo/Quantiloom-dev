{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiloom:dataset:export:1",
  "title": "Quantiloom export transaction, version 1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "record_id",
    "state",
    "capture_status",
    "pairing_status",
    "provenance",
    "replay",
    "products"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "quantiloom.dataset.export"
    },
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "$ref": "#/$defs/hash"
    },
    "state": {
      "enum": [
        "staging",
        "publishing",
        "complete",
        "failed",
        "incomplete"
      ]
    },
    "capture_status": {
      "enum": [
        "complete",
        "failed",
        "incomplete"
      ]
    },
    "pairing_status": {
      "enum": [
        "not_requested",
        "pending",
        "complete",
        "failed"
      ]
    },
    "provenance": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "replay": {
      "$ref": "#/$defs/artifact"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/artifact"
          }
        ],
        "required": [
          "product_id",
          "size_bytes",
          "description"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
