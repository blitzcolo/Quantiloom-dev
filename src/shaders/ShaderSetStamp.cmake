# Compute the SHADERSET digest over the compiled .spv set, and emit it twice:
# as the stamp installed beside the shaders, and as a C++ header the library
# compiles in so it can reject a stale resource copy at runtime.
#
#   cmake -DSHADER_DIR=<dir with the .spv> -DNAMES="a.spv;b.spv"
#         -DSTAMP=<SHADERSET path> -DHEADER=<ShaderSetDigest.hpp path>
#         -P src/shaders/ShaderSetStamp.cmake
#
# The digest is the SHA-256 of one "<name> <sha256 of contents>" line per
# file, in sorted name order. Both outputs are rewritten only when their
# content changes, so an unchanged shader set does not recompile the library.

if(NOT DEFINED SHADER_DIR OR NOT DEFINED STAMP OR NOT DEFINED HEADER)
    message(FATAL_ERROR "ShaderSetStamp.cmake needs SHADER_DIR, STAMP and HEADER")
endif()

set(_input "")
foreach(_name IN LISTS NAMES)
    if(NOT EXISTS "${SHADER_DIR}/${_name}")
        message(FATAL_ERROR "ShaderSetStamp: missing ${SHADER_DIR}/${_name}")
    endif()
    file(SHA256 "${SHADER_DIR}/${_name}" _file_hash)
    string(APPEND _input "${_name} ${_file_hash}\n")
endforeach()
string(SHA256 _digest "${_input}")

set(_stamp_text "${_digest}\n")
set(_header_text
"#pragma once

// Generated by src/shaders/ShaderSetStamp.cmake: the SHA-256 over the sorted
// names and contents of the .spv set this library was built with. Compared at
// runtime against <resource root>/shaders/spirv/SHADERSET.

namespace quantiloom::core {
inline constexpr const char* kShaderSetDigest = \"${_digest}\";
}  // namespace quantiloom::core
")

function(_ql_write_if_changed _path _content)
    set(_old "")
    if(EXISTS "${_path}")
        file(READ "${_path}" _old)
    endif()
    if(NOT _old STREQUAL _content)
        file(WRITE "${_path}" "${_content}")
        message(STATUS "Shader set stamp: ${_digest}")
    endif()
endfunction()

_ql_write_if_changed("${STAMP}" "${_stamp_text}")
_ql_write_if_changed("${HEADER}" "${_header_text}")
