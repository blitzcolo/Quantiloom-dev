// ============================================================================
// Quantiloom - Any-Hit Shader
// ============================================================================
// Answers one question about an intersection the traversal has found: is the
// surface actually there at that texel?
//
// glTF's alphaMode gives two ways it might not be. MASK is a hole -- the texel
// is either present or absent, decided against alphaCutoff. BLEND is partial
// coverage, which a path tracer resolves stochastically: the surface is present
// for a fraction of samples equal to its alpha.
//
// Why this belongs here and not in the closest-hit shader. Zeroing the radiance
// of a masked hit would look plausible in the visible bands and is badly wrong
// in the thermal ones: a hole in a leaf should show the 300 K wall behind it,
// and zero radiance reports 0 W/sr/m^2 -- colder than deep space. IgnoreHit()
// is the only construction that makes the intersection never have happened, so
// the ray continues to whatever is genuinely behind. That is why all seven
// bands are correct here with no per-band code: alpha is coverage, and coverage
// has no wavelength.
//
// This stage runs only for geometry whose BLAS was built without
// VK_GEOMETRY_OPAQUE_BIT_KHR -- see IsOpaqueForRayTracing in RenderCore.cpp.
// Opaque materials never reach it, and neither do transmissive ones: a
// refracting surface bends the ray and splits it by Fresnel, which is a
// different physics from coverage, and running both would remove the surface
// twice.
// ============================================================================

#include "common.hlsli"
#include "hit_common.hlsli"

[shader("anyhit")]
void main(inout Payload payload, in HitAttributes attribs) {
    const InstanceGeometryInfo geoInfo = instanceGeometryInfo[InstanceIndex()];
    const MaterialData material = materials[geoInfo.materialId];

    // Gated, and this gate is what keeps every physics gate in the suite
    // bit-identical: the furnace cavities and the open-sky scene are all
    // alphaMode OPAQUE with an alpha of 1, and an ungated test would put a
    // texture fetch and a compare on their critical path for no reason.
    if (material.alphaMode == ALPHA_MODE_OPAQUE) {
        return;
    }

    // Barycentric UV. Ten lines rather than a call into closest-hit's version,
    // which is interleaved with normals, tangents and geometric-normal
    // construction that four band branches depend on -- none of which an
    // any-hit has any use for.
    const uint base = geoInfo.indexOffset + PrimitiveIndex() * 3u;
    const float2 uv0 = uvBuffer[geoInfo.uvOffset + indexBuffer[base + 0u]];
    const float2 uv1 = uvBuffer[geoInfo.uvOffset + indexBuffer[base + 1u]];
    const float2 uv2 = uvBuffer[geoInfo.uvOffset + indexBuffer[base + 2u]];
    const float2 uv = uv0 * (1.0 - attribs.bary.x - attribs.bary.y) +
                      uv1 * attribs.bary.x + uv2 * attribs.bary.y;

    const float alpha = SurfaceAlpha(material, uv);

    if (material.alphaMode == ALPHA_MODE_MASK) {
        // A hole, decided per texel. Not a fade: glTF is explicit that MASK is
        // binary, so a leaf edge is either there or it is not, and the cutoff
        // is where the author put the boundary.
        if (alpha < material.alphaCutoff) {
            IgnoreHit();
        }
    }
}
