// ============================================================================
// Quantiloom - Ray Generation Shader
// ============================================================================
// Generates primary camera rays and writes output to storage image
//
// SPECTRAL RENDERING:
// - Wavelength is set via camera.wavelength_nm (push constants)
// - Output is RGB (for single λ, grayscale; for multi-λ, accumulated bands)
// ============================================================================

#include "common.hlsli"

// ============================================================================
// Bindings
// ============================================================================

[[vk::binding(0, 0)]] RWTexture2D<float4> outputImage;
[[vk::binding(1, 0)]] RaytracingAccelerationStructure scene;
[[vk::binding(2, 0)]] StructuredBuffer<LightingParams> lightingParams;  // Fallback lighting (unused here)

// Primary-hit depth AOV: distance along the normalized primary ray, -1 on
// miss. Overwritten every frame (never accumulated) so it always reflects the
// current scene; consumed by ExternalRenderContext::BlitDepthTo.
[[vk::binding(22, 0)]] RWTexture2D<float> depthImage;

// The push-constant block lives in common.hlsli, shared with the closest-hit
// and miss shaders.

// ============================================================================
// PCG Seed (Wang Hash)
// ============================================================================
// Seeds the PCG stream that the closest-hit shader draws from past the first
// bounce. The first bounce itself is stratified and does not touch this -- see
// sampling.hlsli.
// Reference: "Hash Functions for GPU Rendering" (Mark Jarzynski, 2020)
// ============================================================================

uint WangHash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

// ============================================================================
// Ray Generation Entry Point
// ============================================================================

[shader("raygeneration")]
void main() {
    // Get pixel coordinates
    uint2 launchID = DispatchRaysIndex().xy;
    uint2 launchSize = DispatchRaysDimensions().xy;

    // ========================================================================
    // Initialize the PCG Seed
    // ========================================================================
    // Combine pixel position, frame index, and sample index so that every
    // (pixel, sample) pair gets its own stream. Handed to the payload below and
    // consumed only past the first bounce.
    uint seed = pushConsts.randomSeed;
    seed ^= launchID.x * 1973 + launchID.y * 9277;
    seed ^= pushConsts.frameIndex * 26699;
    seed ^= pushConsts.sampleIndex * 18397;
    seed = WangHash(seed);

    // ========================================================================
    // Subpixel Jittering
    // ========================================================================
    // Where in the pixel this sample lands, in [-0.5, 0.5]^2. Drawn from the
    // stratified sequence rather than from `seed`: the film plane is the one
    // dimension every path shares regardless of what it hits, so it is the
    // dimension stratification helps most, and clumped jitter shows up directly
    // as ragged edges. This comment used to say "stratified jittering" over two
    // white-noise draws; now it is true.
    float2 jitter = float2(0.0, 0.0);
    if (pushConsts.totalSamples > 1) {
        jitter = StratifiedSample2D(pushConsts.sampleIndex, launchID,
                                    SAMPLE_SLOT_JITTER,
                                    pushConsts.sequenceSeed) - 0.5;
    }

    // Convert to normalized device coordinates [0, 1]
    float2 pixelCenter = float2(launchID) + 0.5 + jitter;
    float2 uv = pixelCenter / float2(launchSize);

    // Convert UV to NDC [-1, 1]
    // Note: Flip Y because screen coordinates are top-down (Y increases downward)
    // but camera up vector points upward
    float2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;  // Flip Y axis

    // Camera ray. The two projections differ in which of origin and direction
    // varies across the film plane: perspective rays share an origin and fan
    // out, orthographic rays share a direction and start spread across the
    // plane. Everything downstream -- differentials, the payload, the trace --
    // is the same either way.
    float3 direction;
    float3 origin;
    const bool orthographic =
        pushConsts.camera.projection == CAMERA_PROJECTION_ORTHOGRAPHIC;

    if (orthographic) {
        // Half-extents from the film height; the width follows the aspect
        // ratio, exactly as fovScale is scaled by it in the perspective case.
        const float halfH = pushConsts.camera.orthoHeight * 0.5;
        const float halfW = halfH * pushConsts.camera.aspectRatio;
        direction = normalize(pushConsts.camera.forward);
        origin = pushConsts.camera.origin +
                 ndc.x * pushConsts.camera.right * halfW +
                 ndc.y * pushConsts.camera.up * halfH;
    } else {
        direction = normalize(
            pushConsts.camera.forward +
            ndc.x * pushConsts.camera.right * pushConsts.camera.fovScale * pushConsts.camera.aspectRatio +
            ndc.y * pushConsts.camera.up * pushConsts.camera.fovScale
        );
        origin = pushConsts.camera.origin;
    }

    // Setup ray
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = 0.001;   // Avoid self-intersection
    ray.TMax = 10000.0; // Far plane

    // ========================================================================
    // Trace the primary ray
    // ========================================================================
    // Initialize payload
    Payload payload;
    payload.radiance = float4(0.0, 0.0, 0.0, 0.0);

    // Initialize shadow flag (will be set by shadow miss shader)
    payload.isShadowed = 0;

    // A primary ray carries the whole visible band. Only a dispersive
    // refraction narrows it to one wavelength -- see Payload::heroLambda.
    payload.heroLambda = 0.0;

    // Initialize recursion depth (0 = primary ray)
    payload.depth = 0;

    // Initialize RNG state from pixel seed for stochastic decisions
    payload.rngState = seed;

    // Miss sentinel for the depth AOV; the closest-hit shader overwrites it
    payload.primaryHitT = -1.0;

    // A primary ray is not a BSDF sample, so an emitter it lands on shows its
    // full emission -- what the camera sees looking straight at a light.
    payload.bsdfPdf = 0.0;

    // Trace ray (hit group index 0, miss index 0)
    TraceRay(
        scene,              // Acceleration structure
        RAY_FLAG_NONE,      // Ray flags
        0xFF,               // Instance mask (all instances visible)
        0,                  // SBT ray contribution offset
        0,                  // SBT multiplier
        0,                  // Miss index
        ray,                // Ray descriptor
        payload             // Ray payload
    );

    // Snapshot the primary hit distance before anything else can touch the
    // payload. Written unconditionally: unlike radiance this is not averaged,
    // the last sample simply wins (jitter makes it flicker sub-pixel at
    // silhouettes, which the grid overlay's epsilon absorbs).
    depthImage[launchID] = payload.primaryHitT;

    // ========================================================================
    // Output: Accumulative Sampling with Progressive Refinement
    // ========================================================================
    // Implements temporal accumulation for multi-sample anti-aliasing (MSAA)
    // and Monte Carlo path tracing convergence.
    //
    // ACCUMULATION STRATEGY:
    // - First sample (sampleIndex == 0): Initialize with current radiance
    // - Subsequent samples: Blend with previous accumulated value using
    //   incremental averaging: new_avg = old_avg + (sample - old_avg) / (N+1)
    //
    // This approach:
    // 1. Avoids numerical instability from sum overflow (no large accumulator)
    // 2. Provides progressive refinement (each sample improves the estimate)
    // 3. Enables real-time preview during rendering
    // 4. Mathematically equivalent to: final = sum(samples) / N
    //
    // OUTPUT FORMAT:
    // - Linear HDR radiance (W·sr⁻¹·m⁻²) in RGB or spectral mode
    // - Values can exceed 1.0 (HDR, stored as float32)
    // - Ready for EXR export (no tone mapping, no gamma correction)
    // ========================================================================

    float3 linearHDR = payload.radiance.rgb;

    // Clamp to a reasonable HDR range, so a firefly cannot dominate the
    // accumulation. SYMMETRIC on purpose -- the lower bound used to be 0.
    //
    // A sample may legitimately be negative. A hero-wavelength ray carries one
    // wavelength, and a monochromatic radiance converted to linear sRGB lands
    // outside the gamut: at 590 nm the blue channel is genuinely about
    // -0.00083 for the prism scene. Those negative excursions are what cancel
    // against other wavelengths' positive ones when the samples are averaged,
    // and clipping each sample at zero first destroys the cancellation. It made
    // the estimator biased rather than merely noisy -- +18% on transmission
    // pixels, weighted towards red because R has the largest matrix
    // coefficients and therefore the largest excursions in both directions.
    //
    // Bounding fireflies does not require a one-sided bound; -10000 serves that
    // purpose as well as 0 did. Samples that reach here without a hero
    // wavelength were already clamped non-negative by the closest-hit and miss
    // shaders, so nothing else changes.
    linearHDR = clamp(linearHDR, -10000.0, 10000.0);

    if (pushConsts.sampleIndex == 0) {
        // First sample: Initialize output with current radiance
        outputImage[launchID] = float4(linearHDR, 1.0);
    } else {
        // Subsequent samples: Incremental averaging
        // Formula: new_avg = old_avg + (sample - old_avg) / (N+1)
        // This is numerically stable and avoids overflow
        float4 previousAccum = outputImage[launchID];
        float3 previousRadiance = previousAccum.rgb;

        // Compute weight for current sample (1 / totalSamplesProcessed)
        float weight = 1.0 / float(pushConsts.sampleIndex + 1);

        // Incremental blend: blend current sample into accumulated average
        float3 newRadiance = previousRadiance + (linearHDR - previousRadiance) * weight;

        outputImage[launchID] = float4(newRadiance, 1.0);
    }
}
