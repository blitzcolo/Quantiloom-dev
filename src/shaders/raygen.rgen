// ============================================================================
// Quantiloom - Ray Generation Shader
// ============================================================================
// Generates primary camera rays and writes output to storage image
//
// SPECTRAL RENDERING:
// - Wavelength is set via camera.wavelength_nm (push constants)
// - Output is RGB (for single λ, grayscale; for multi-λ, accumulated bands)
// ============================================================================

#include "common.hlsli"

// ============================================================================
// Bindings
// ============================================================================

[[vk::binding(0, 0)]] RWTexture2D<float4> outputImage;
[[vk::binding(1, 0)]] RaytracingAccelerationStructure scene;
[[vk::binding(2, 0)]] StructuredBuffer<LUTData> skyLUT;

// ============================================================================
// Push Constants (Extended for Accumulation Sampling)
// ============================================================================

struct PushConstantsRayGen {
    CameraData camera;       // Camera parameters
    uint frameIndex;         // Frame counter (for temporal effects)
    uint sampleIndex;        // Current sample index (0 to spp-1)
    uint totalSamples;       // Total samples per pixel (spp)
    uint randomSeed;         // Random seed for this frame
};

[[vk::push_constant]] PushConstantsRayGen pushConsts;

// ============================================================================
// Random Number Generator (Wang Hash)
// ============================================================================
// Fast pseudo-random number generator for GPU
// Reference: "Hash Functions for GPU Rendering" (Mark Jarzynski, 2020)
// ============================================================================

uint WangHash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

// Generate random float in [0, 1)
float RandomFloat(inout uint seed) {
    seed = WangHash(seed);
    return float(seed) / 4294967296.0;  // 2^32
}

// Generate random float2 in [0, 1)^2
float2 RandomFloat2(inout uint seed) {
    return float2(RandomFloat(seed), RandomFloat(seed));
}

// ============================================================================
// Ray Generation Entry Point
// ============================================================================

[shader("raygeneration")]
void main() {
    // Get pixel coordinates
    uint2 launchID = DispatchRaysIndex().xy;
    uint2 launchSize = DispatchRaysDimensions().xy;

    // ========================================================================
    // Initialize Random Seed
    // ========================================================================
    // Combine pixel position, frame index, and sample index for unique seed
    // This ensures different random sequences for each pixel and sample
    uint seed = pushConsts.randomSeed;
    seed ^= launchID.x * 1973 + launchID.y * 9277;
    seed ^= pushConsts.frameIndex * 26699;
    seed ^= pushConsts.sampleIndex * 18397;
    seed = WangHash(seed);

    // ========================================================================
    // Subpixel Jittering (Stochastic Sampling)
    // ========================================================================
    // Add random offset within pixel for anti-aliasing
    // Range: [-0.5, 0.5] for uniform distribution within pixel
    float2 jitter = float2(0.0, 0.0);
    if (pushConsts.totalSamples > 1) {
        jitter = RandomFloat2(seed) - 0.5;  // Stratified jittering
    }

    // Convert to normalized device coordinates [0, 1]
    float2 pixelCenter = float2(launchID) + 0.5 + jitter;
    float2 uv = pixelCenter / float2(launchSize);

    // Convert UV to NDC [-1, 1]
    // Note: Flip Y because screen coordinates are top-down (Y increases downward)
    // but camera up vector points upward
    float2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;  // Flip Y axis

    // Compute ray direction using camera parameters
    float3 direction = normalize(
        pushConsts.camera.forward +
        ndc.x * pushConsts.camera.right * pushConsts.camera.fovScale * pushConsts.camera.aspectRatio +
        ndc.y * pushConsts.camera.up * pushConsts.camera.fovScale
    );

    // Ray origin from camera
    float3 origin = pushConsts.camera.origin;

    // Setup ray
    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = 0.001;   // Avoid self-intersection
    ray.TMax = 10000.0; // Far plane

    // ========================================================================
    // Initialize Ray Differentials
    // ========================================================================
    // Compute ray direction differentials for adjacent pixels
    // This enables proper texture LOD computation for antialiasing
    //
    // For a pinhole camera with perspective projection:
    //   dD/dx = difference in ray direction between (x, y) and (x+1, y)
    //   dD/dy = difference in ray direction between (x, y) and (x, y+1)
    //
    // Ray origin is the same for all rays (pinhole camera), so dO/dx = dO/dy = 0
    // ========================================================================

    // Compute ray direction for adjacent pixels (x+1, y) and (x, y+1)
    float2 pixelCenterXp1 = float2(launchID.x + 1, launchID.y) + 0.5;
    float2 pixelCenterYp1 = float2(launchID.x, launchID.y + 1) + 0.5;

    float2 uvXp1 = pixelCenterXp1 / float2(launchSize);
    float2 uvYp1 = pixelCenterYp1 / float2(launchSize);

    float2 ndcXp1 = uvXp1 * 2.0 - 1.0;
    float2 ndcYp1 = uvYp1 * 2.0 - 1.0;
    ndcXp1.y = -ndcXp1.y;  // Flip Y
    ndcYp1.y = -ndcYp1.y;

    // Compute adjacent ray directions
    float3 directionXp1 = normalize(
        camera.forward +
        ndcXp1.x * camera.right * camera.fovScale * camera.aspectRatio +
        ndcXp1.y * camera.up * camera.fovScale
    );

    float3 directionYp1 = normalize(
        camera.forward +
        ndcYp1.x * camera.right * camera.fovScale * camera.aspectRatio +
        ndcYp1.y * camera.up * camera.fovScale
    );

    // Compute differentials (change in direction per pixel)
    float3 dDdx = directionXp1 - direction;
    float3 dDdy = directionYp1 - direction;

    // ========================================================================
    // Trace Ray with Differentials
    // ========================================================================
    // Initialize payload
    Payload payload;
    payload.radiance = float3(0.0, 0.0, 0.0);

    // Set ray differentials
    payload.dDdx = dDdx;
    payload.dDdy = dDdy;
    payload.dOdx = float3(0.0, 0.0, 0.0);  // Pinhole camera: origin is constant
    payload.dOdy = float3(0.0, 0.0, 0.0);

    // Trace ray (hit group index 0, miss index 0)
    TraceRay(
        scene,              // Acceleration structure
        RAY_FLAG_NONE,      // Ray flags
        0xFF,               // Instance mask (all instances visible)
        0,                  // SBT ray contribution offset
        0,                  // SBT multiplier
        0,                  // Miss index
        ray,                // Ray descriptor
        payload             // Ray payload
    );

    // ========================================================================
    // Output: Linear HDR Radiance (EXR-ready)
    // ========================================================================
    // The payload.radiance is in linear HDR space (float32).
    // We output it AS-IS for EXR saving (no tone mapping, no gamma correction).
    //
    // IMPORTANT: This is the CORRECT approach for EXR output!
    // - EXR expects linear HDR data (preserves full dynamic range)
    // - Tone mapping and gamma correction should ONLY be applied when:
    //   1. Saving to LDR formats (JPG/PNG) - apply in CPU code before save
    //   2. Displaying to screen (Swapchain) - apply in post-process shader
    //   3. Real-time preview - apply in compute shader or fragment shader
    //
    // For viewing EXR files, use HDR-capable viewers (e.g., OpenImageIO's iv,
    // Photoshop, Nuke) which will apply their own tone mapping.
    // ========================================================================

    float3 linearHDR = payload.radiance;

    // Clamp to reasonable HDR range (prevents fireflies from dominating)
    linearHDR = clamp(linearHDR, 0.0, 10000.0);

    // Write linear HDR to output image (no post-processing)
    // NOTE: Values can exceed 1.0 (this is expected for HDR)
    outputImage[launchID] = float4(linearHDR, 1.0);
}
