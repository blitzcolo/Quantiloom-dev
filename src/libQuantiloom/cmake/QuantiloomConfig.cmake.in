@PACKAGE_INIT@

# ============================================================================
# QuantiloomConfig.cmake - find_package(Quantiloom) configuration
# ============================================================================
#
# This file is generated by CMake and installed alongside libQuantiloom.
# It allows consumers to use find_package(Quantiloom) to locate the library.
#
# Usage:
#   find_package(Quantiloom REQUIRED)
#   target_link_libraries(MyApp PRIVATE Quantiloom::libQuantiloom)
#
# Requirements:
#   - Vulkan SDK (find_package(Vulkan))
#   - glm (find_package(glm) or header-only include)
#
# ============================================================================

include(CMakeFindDependencyMacro)

# Find required PUBLIC dependencies
# (PRIVATE deps like spdlog, toml++, VMA are hidden - not needed by consumers)
find_dependency(Vulkan REQUIRED)
find_dependency(glm REQUIRED)

# Include exported targets
include("${CMAKE_CURRENT_LIST_DIR}/QuantiloomTargets.cmake")

# Provide version info
set(Quantiloom_VERSION @PROJECT_VERSION@)
set(Quantiloom_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(Quantiloom_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(Quantiloom_VERSION_PATCH @PROJECT_VERSION_PATCH@)

check_required_components(Quantiloom)
