# ============================================================================
# QuantiloomConfig.cmake - CMake package configuration for libQuantiloom
#
# This file is generated by configure_package_config_file() and allows
# external projects to use find_package(Quantiloom) to link against
# libQuantiloom.
#
# Usage:
#   find_package(Quantiloom REQUIRED)
#   target_link_libraries(MyApp PRIVATE Quantiloom::libQuantiloom)
#
# This will automatically:
#   - Link the libQuantiloom library
#   - Add include directories for Quantiloom headers
#   - Find and propagate required dependencies (Vulkan, GLM)
# ============================================================================

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Required dependencies that consumers need
find_dependency(Vulkan REQUIRED)
find_dependency(glm REQUIRED)

# Include the generated targets
include("${CMAKE_CURRENT_LIST_DIR}/QuantiloomTargets.cmake")

# Add glm to libQuantiloom's interface (for consumers' include paths)
if(TARGET Quantiloom::libQuantiloom AND TARGET glm::glm)
    set_property(TARGET Quantiloom::libQuantiloom APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES glm::glm
    )
endif()

# Verify targets exist
check_required_components(Quantiloom)

# Provide helpful message
if(NOT Quantiloom_FIND_QUIETLY)
    message(STATUS "Found Quantiloom: ${CMAKE_CURRENT_LIST_DIR}")
endif()
